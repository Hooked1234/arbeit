      <mxCell id="stufe_2_diff_n0" value="Zielkonflikt Gruppenpräsentation, Variante B:&lt;br&gt;je Mitglied eine eigene Leistung, alle beziehen sich&lt;br&gt;auf dieselbe Gruppenpräsentation. Die Komposition&lt;br&gt;zu Student bleibt damit unverändert." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=6;fontFamily=Arial;fontSize=10;fillColor=#FFFFFF;strokeColor=#2E4A6B;fontColor=#2E4A6B;" vertex="1" parent="1"><mxGeometry x="700" y="860" width="560" height="84" as="geometry"/></mxCell>
      <mxCell id="stufe_2_diff_n1" value="Blau  unverändert aus Aufgabe 1&lt;br&gt;Grün  neu in Aufgabe 2&lt;br&gt;Gelb  gegenüber Aufgabe 1 umgebaut" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=6;fontFamily=Arial;fontSize=10;fillColor=#FFFFFF;strokeColor=#2E4A6B;fontColor=#2E4A6B;" vertex="1" parent="1"><mxGeometry x="700" y="990" width="560" height="68" as="geometry"/></mxCell>
      <mxCell id="stufe_2_diff_n2" value="Entfallen: die Aggregation Studiengang - Modul&lt;br&gt;aus Aufgabe 1. Sie kann Art und Fachsemester&lt;br&gt;nicht tragen und weicht der Modulzuordnung." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=6;fontFamily=Arial;fontSize=10;fillColor=#FFFFFF;strokeColor=#2E4A6B;fontColor=#2E4A6B;" vertex="1" parent="1"><mxGeometry x="400" y="262" width="480" height="68" as="geometry"/></mxCell>
