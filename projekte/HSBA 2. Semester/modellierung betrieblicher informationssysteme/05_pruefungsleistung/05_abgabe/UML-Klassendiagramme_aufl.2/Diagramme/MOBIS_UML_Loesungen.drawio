        <mxCell id="aufgabe_3_veranstaltungsmanagement_note_2" value="Preis- und Zahlungsregeln: /gesamtbetrag = Summe(Ticket.preis). Bei vollständiger Bezahlung entspricht die Summe erfolgreicher, nicht erstatteter Zahlungen dem Gesamtbetrag." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF7DD;strokeColor=#C7A84D;fontFamily=Arial;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="930" width="620" height="75" as="geometry" />
        </mxCell>
        <mxCell id="aufgabe_3_veranstaltungsmanagement_note_3" value="Zeit- und Kapazitätsregeln: Programmpunkte liegen im Veranstaltungszeitraum; Veranstaltungen am selben Ort dürfen sich zeitlich nicht überschneiden; die Anzahl gültiger Tickets darf die Kapazität nicht überschreiten." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF7DD;strokeColor=#C7A84D;fontFamily=Arial;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="930" width="685" height="75" as="geometry" />
        </mxCell>
      </root>
