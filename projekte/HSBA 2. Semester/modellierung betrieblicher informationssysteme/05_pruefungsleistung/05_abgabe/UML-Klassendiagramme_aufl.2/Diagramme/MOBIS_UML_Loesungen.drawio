        <mxCell id="aufgabe_2_hotelverwaltung_note_1" value="Zeitregel: Ein Zimmer ist nur verfügbar, wenn betriebsstatus = BETRIEBSBEREIT gilt und keine bestätigte oder eingecheckte Reservierung den Zeitraum [anreise, abreise) überlappt. Fuer eine Zimmerposition gilt anzahl = 1." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF7DD;strokeColor=#C7A84D;fontFamily=Arial;fontSize=10;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
